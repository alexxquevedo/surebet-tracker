# ─── Database (same as main app) ────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@host:5432/dbname?schema=public"
DIRECT_URL="postgresql://user:password@host:5432/dbname?schema=public"

# ─── Telegram Bot ────────────────────────────────────────────────────────────
TELEGRAM_TOKEN="your_telegram_bot_token"

# ─── Betfair Exchange API ─────────────────────────────────────────────────────
# Obtener en: https://developer.betfair.com/
# 1. Crea una app en "My Applications" → App Key
# 2. Para non-interactive login (VPS): usa la API de certificate login
#    requiere generar un certificado SSL: https://docs.developer.betfair.com/display/1smk3cen4v3lu3yomq5qye0ni/Non-Interactive+(bot)+login
BETFAIR_APP_KEY="your_betfair_app_key"
BETFAIR_USERNAME="your_betfair_username"
BETFAIR_PASSWORD="your_betfair_password"
# Rutas al certificado SSL (solo necesario para non-interactive login)
# BETFAIR_CERT_PATH="/path/to/client-2048.crt"
# BETFAIR_KEY_PATH="/path/to/client-2048.key"

# ─── Proxy GLOBAL (se aplica a todos los scrapers excepto los que tienen proxy específico) ──
# Recomendado: Webshare.io (residencial) o Smartproxy
PROXY_HOST=""
PROXY_PORT="80"
PROXY_USERNAME=""
PROXY_PASSWORD=""

# ─── Proxy RESIDENCIAL (scrapers bloqueados por datacenter OVH) ──────────────
# Afecta a: Bwin, Sportium, Codere, WilliamHill, DaznBet
# Casas con Cloudflare Enterprise (Bet365) tienen su propia config más abajo.
#
# Proveedores recomendados con IPs españolas:
#   - Brightdata Residential: proxy residencial rotatorio ES
#   - IPRoyal: https://iproyal.com → Residential Proxies → España
#   - Webshare Residential: webshare.io/rotating-proxy
#
# Formato RESIDENTIAL_PROXY_URL: http://host:port  (user/pass en las vars de abajo)
# Ejemplo: RESIDENTIAL_PROXY_URL="http://geo.iproyal.com:12321"
RESIDENTIAL_PROXY_URL=""
RESIDENTIAL_PROXY_USER=""
RESIDENTIAL_PROXY_PASS=""

# ─── Proxy RESIDENCIAL via router Cudy LT500 + SIM Digi ──────────────────────
# Arquitectura: VPS ←—WireGuard—→ Cudy LT500 (SIM Digi ES) → Internet
# Setup: sudo bash scripts/setup_proxy_vps.sh  (ver output para config del router)
#
# Una vez el router esté conectado (lunes 25/08), microsocks escucha en 10.8.0.2:1080.
# Formato soportado: socks5://host:port  o  http://user:pass@host:port
#
# Casas que necesitan proxy ES:
#   Kambi:      LeoVegas, 888sport, Casumo, Betsson ES, Unibet, Marca, Kirolbet
#   Altenar:    Luckia, Casino Gran Madrid, TonyBet
#   Otras:      Sportium, DaznBet, Bet365, Bwin, WilliamHill, Betfair, Betway, Interwetten, Betano

# Proxy Kambi CDN (eu-offering.kambicdn.org)
KAMBI_PROXY_URL="socks5://10.8.0.2:1080"

# Proxy Altenar CDN
ALTENAR_PROXY_URL="socks5://10.8.0.2:1080"

# Proxy casas individuales (todas usan el mismo relay por defecto)
SPORTIUM_PROXY_URL="socks5://10.8.0.2:1080"
DAZNBET_PROXY_URL="socks5://10.8.0.2:1080"
BWIN_PROXY_URL="socks5://10.8.0.2:1080"
WILLIAMHILL_PROXY_URL="socks5://10.8.0.2:1080"
BETWAY_PROXY_URL="socks5://10.8.0.2:1080"
INTERWETTEN_PROXY_URL="socks5://10.8.0.2:1080"
BETANO_PROXY_URL="socks5://10.8.0.2:1080"

# Bet365 — además de proxy ES puede necesitar User-Agent override
BET365_PROXY_URL="socks5://10.8.0.2:1080"

# Betfair Exchange API — normalmente funciona sin proxy (API key based)
# BETFAIR_PROXY_URL="socks5://10.8.0.2:1080"

# ─── Proxy ESPECÍFICO para Bet365 ─────────────────────────────────────────────
# Bet365 usa Cloudflare Enterprise con IP-reputation scoring.
# REQUIERE proxy residencial — IPs de datacenter (OVH, AWS, etc.) están bloqueadas.
# Formato: http://user:pass@host:port  o  http://host:port
#
# Proveedores recomendados:
#   - Webshare.io (residencial rotating): ~$2.99/GB
#   - Brightdata (ex-Luminati): premium pero el más fiable para CF bypass
#   - Oxylabs: muy bueno pero caro
#   - Smartproxy: buen compromiso precio/calidad
#
# Ejemplo: BET365_PROXY_URL="http://alexq:mypass@rotating.webshare.io:80"
BET365_PROXY_URL=""
BET365_PROXY_USER=""
BET365_PROXY_PASS=""

# ─── The Odds API ────────────────────────────────────────────────────────────
# API agregada para Bet365, Betsson, Bwin, WilliamHill, Betfair, Unibet.
# Obtener en: https://the-odds-api.com → Dashboard → API Key
# Plan recomendado: Standard (30,000 créditos/mes)
# Sin esta clave, OddsApiScraper se desactiva automáticamente (no lanza error).
ODDS_API_KEY=""
# Frecuencia mínima entre llamadas a la API (evita superar quota)
# Live: por defecto 90s (aunque el orchestrator polla cada 30s)
# Prematch: por defecto 600s (10min)
ODDS_API_LIVE_TTL_SEC="90"
ODDS_API_PREMATCH_TTL_SEC="600"

# ─── Scanner tuning ───────────────────────────────────────────────────────────
# Mínimo % de profit para considerar un arb
MIN_PROFIT_PCT="0.5"
# Intervalo poll live (segundos)
LIVE_POLL_INTERVAL="30"
# Intervalo poll prematch (segundos)
PREMATCH_POLL_INTERVAL="300"

# ─── Playwright ──────────────────────────────────────────────────────────────
# Ruta al binario de Chromium (necesario en Ubuntu si el bundled de Playwright no funciona)
# CHROMIUM_PATH="/usr/bin/chromium-browser"
